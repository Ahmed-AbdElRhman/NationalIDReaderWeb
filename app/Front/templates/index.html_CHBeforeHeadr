                                    <div class="info-actions">
                                        <button class="edit-btn" data-target="firstName">
                                            <i class="fas fa-edit"></i> Edit
                                        </button>
                                        <button class="save-btn" data-target="firstName">
                                            <i class="fas fa-save"></i> Save
                                        </button>
                                        <button class="copy-btn" data-target="firstName">
                                            <i class="far fa-copy"></i> Copy
                                        </button>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="info-item">
                                <span class="info-label">Second Name</span>
                                <div class="info-value">
                                    <span id="secondName" class="info-text" contenteditable="false">N/A</span>
                                    <div class="info-actions">
                                        <button class="edit-btn" data-target="secondName">
                                            <i class="fas fa-edit"></i> Edit
                                        </button>
                                        <button class="save-btn" data-target="secondName">
                                            <i class="fas fa-save"></i> Save
                                        </button>
                                        <button class="copy-btn" data-target="secondName">
                                            <i class="far fa-copy"></i> Copy
                                        </button>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="info-item">
                                <span class="info-label">Full Name</span>
                                <div class="info-value">
                                    <span id="fullName" class="info-text" contenteditable="false">N/A</span>
                                    <div class="info-actions">
                                        <button class="edit-btn" data-target="fullName">
                                            <i class="fas fa-edit"></i> Edit
                                        </button>
                                        <button class="save-btn" data-target="fullName">
                                            <i class="fas fa-save"></i> Save
                                        </button>
                                        <button class="copy-btn" data-target="fullName">
                                            <i class="far fa-copy"></i> Copy
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Address</span>
                                <div class="info-value">
                                    <span id="address" class="info-text" contenteditable="false">N/A</span>
                                    <div class="info-actions">
                                        <button class="edit-btn" data-target="address">
                                            <i class="fas fa-edit"></i> Edit
                                        </button>
                                        <button class="save-btn" data-target="address">
                                            <i class="fas fa-save"></i> Save
                                        </button>
                                        <button class="copy-btn" data-target="address">
                                            <i class="far fa-copy"></i> Copy
                                        </button>
                                    </div>
                                </div>
                            </div>
                            
                        </div>
                        
                        <!-- Column 2 -->
                        <div>
                            <div class="info-item">
                                <span class="info-label">National ID</span>
                                <div class="info-value">
                                    <span id="nationalId" class="info-text" contenteditable="false">N/A</span>
                                    <div class="info-actions">
                                        <button class="edit-btn" data-target="nationalId">
                                            <i class="fas fa-edit"></i> Edit
                                        </button>
                                        <button class="save-btn" data-target="nationalId">
                                            <i class="fas fa-save"></i> Save
                                        </button>
                                        <button class="copy-btn" data-target="nationalId">
                                            <i class="far fa-copy"></i> Copy
                                        </button>
                                    </div>
                                </div>
                            </div>
                            
                            
                            <div class="info-item">
                                <span class="info-label">Date of Birth</span>
                                <div class="info-value">
                                    <span id="birth" class="info-text" contenteditable="false">N/A</span>
                                    <div class="info-actions">
                                        <button class="edit-btn" data-target="birth">
                                            <i class="fas fa-edit"></i> Edit
                                        </button>
                                        <button class="save-btn" data-target="birth">
                                            <i class="fas fa-save"></i> Save
                                        </button>
                                        <button class="copy-btn" data-target="birth">
                                            <i class="far fa-copy"></i> Copy
                                        </button>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="info-item">
                                <span class="info-label">Governorate</span>
                                <div class="info-value">
                                    <span id="gov" class="info-text" contenteditable="false">N/A</span>
                                    <div class="info-actions">
                                        <button class="edit-btn" data-target="gov">
                                            <i class="fas fa-edit"></i> Edit
                                        </button>
                                        <button class="save-btn" data-target="gov">
                                            <i class="fas fa-save"></i> Save
                                        </button>
                                        <button class="copy-btn" data-target="gov">
                                            <i class="far fa-copy"></i> Copy
                                        </button>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="info-item" style="display: none;">
                                <span class="info-label">Gender</span>
                                <div class="info-value">
                                    <span id="gender" class="info-text" contenteditable="false">N/A</span>
                                    <div class="info-actions">
                                        <button class="edit-btn" data-target="gender">
                                            <i class="fas fa-edit"></i> Edit
                                        </button>
                                        <button class="save-btn" data-target="gender">
                                            <i class="fas fa-save"></i> Save
                                        </button>
                                        <button class="copy-btn" data-target="gender">
                                            <i class="far fa-copy"></i> Copy
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="process-section">
                        <button id="saveAllBtn" class="btn btn-edit" style="display: none;">
                            <i class="fas fa-save"></i> Save All Changes
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
