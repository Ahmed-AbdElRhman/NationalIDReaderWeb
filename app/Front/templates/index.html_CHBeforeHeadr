<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ID Document Processing System</title>
    <link rel="stylesheet" href="../static/fontawesome-free-7.0.0-web/css/all.min.css">
    <link rel="stylesheet" href="../static/index.css">
</head>
<body>
    <!--- status-container ---------------------------------------------------------------------->
    <div class="status-container" id="statusContainer"></div>

    <!--- Main-container ------------------------------------------------------------------------>
    <div class="container">

        <header>
            <h1><i class="fas fa-id-card"></i> ID Document Processing</h1>
        </header>
        <div class="main-content">
            <!--- Left panel (Import and Uploaded Image) ------------------------------------------------------------------------>
            <div class="panel">
                <div class="card compact">
                    <div class="card-header-compact">
                        <h2 class="card-title"><i class="fas fa-file-import"></i> Import</h2>
                        <!-- Compact Language Toggle -->
                        <div class="language-toggle-compact">
                            <span class="language-label">EN</span>
                            <label class="switch">
                                <input type="checkbox" id="languageToggle">
                                <span class="slider round"></span>
                            </label>
                            <span class="language-label">AR</span>
                        </div>
                    </div>
                    
                    <div class="import-options">
                        <div class="scanner-section">
                            <h3 class="section-title"><i class="fas fa-scanner"></i> Scanner</h3>
                            <button id="loadScanners" class="btn btn-sm">
                                <i class="fas fa-search"></i> Load
                            </button>
                            <select id="scannerList" disabled>
                                <option value="">No scanners</option>
                            </select>
                            <button id="scanBtn" class="btn btn-sm btn-warning" style="display: none;" disabled>
                                <i class="fa-solid fa-expand"></i> Scan
                            </button>
                            <button id="scanBtn" class="btn btn-sm btn-warning" onclick="AcquireImage();"">
                                <i class="fa-solid fa-expand"></i> Scan TWAN
                            </button>
                        </div>
                        
                        <div class="upload-section">
                            <h3 class="section-title"><i class="fas fa-upload"></i> File</h3>
                            <input type="file" id="fileInput" accept="image/*,.pdf,.tiff,.tif" class="btn-sm">
                            
                            <div id="dropArea" class="drop-area">
                                <p><i class="fas fa-cloud-upload-alt" style="font-size: 1.1rem;"></i></p>
                                <p>Drag & drop</p>
                                <p><small>(JPG, PNG, TIFF, PDF)</small></p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="process-section">
                        <button id="processBtn" class="btn btn-success">
                            <i class="fas fa-cogs"></i> Process
                        </button>
                    </div>
                    
                    <div id="loading" class="loading">
                        <div class="spinner"></div>
                        <small>Processing...</small>
                    </div>
                </div>
                
                <div class="card" >
                    <h2 class="card-title"><i class="fas fa-image"></i> Uploaded</h2>
                    <div class="image-container">
                        <canvas id="uploadedCanvas" style="max-width: 100%; max-height: 400px; display: none;"></canvas>
                        <img id="uploadedImage" class="image-preview" alt="Uploaded image">
                        <div id="dwtcontrolContainer" style="display: none !important;"></div>
                        <div id="uploadPlaceholder" style="color: #999; display: none;">No document uploaded</div>
                    </div>
                </div>
                <div class="card" style="display: none;">
                    <h2 class="card-title"><i class="fa-regular fa-id-card"></i> Processed</h2>
                    <div class="image-container">
                        <img id="processedImage" class="image-preview" alt="Processed image">
                    </div>
                </div>
            </div>

            <!--- Right panel (Processed Image and Extracted data) ------------------------------------------------------------------------>
            <div class="panel">
                <div class="card">
                    <h2 class="card-title"><i class="fas fa-info-circle"></i> Extracted Data</h2>
                    <div id="extractedInfo" class="extracted-data-grid">
