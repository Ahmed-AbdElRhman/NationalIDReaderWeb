           Dynamsoft.WebTwainEnv.Trial = false;
           Dynamsoft.WebTwainEnv.ResourcesPath = 'Resources';
           Dynamsoft.WebTwainEnv.AutoLoad = true;
           
           var DWObject;
           var docType = Dynamsoft.EnumDWT_ImageType.IT_PDF;
           var scannedImageData = null; // Store the base64 data for sending to server
           
           function Dynamsoft_OnReady() {
               DWObject = Dynamsoft.WebTwainEnv.GetWebTwain('dwtcontrolContainer');
               if (DWObject) {
                   DWObject.RegisterEvent('OnPostAllTransfers', function () {
                       try {
                           // Clear all images except the last one
                           clearPreviousImages();
                           createImageBase64();
                       }
                       catch(err) {
                           alert(err.message);
                       }
                   });
               }
           }
           
           function Dynamsoft_OnPostTransfer() {
               updateLargeViewer();
           }
           
           function Dynamsoft_OnPostLoad(path, name, type) {
               updateLargeViewer();
           }
           
           function Dynamsoft_OnMouseClick() {
               updateLargeViewer();
           }
           
           function AcquireImage() {
               if (DWObject) {
                   DWObject.SelectSource(function () {
                       var OnAcquireImageSuccess, OnAcquireImageFailure;
                       OnAcquireImageSuccess = OnAcquireImageFailure = function () {
                           DWObject.CloseSource();
                       };
                       DWObject.OpenSource();
                       DWObject.IfDisableSourceAfterAcquire = true;
                       DWObject.AcquireImage(OnAcquireImageSuccess, OnAcquireImageFailure);
                   }, function () {
                       console.log('SelectSource failed!');
                   });
               }
           }
           
           function updateLargeViewer() {
               DWObject.CopyToClipboard(DWObject.CurrentImageIndexInBuffer);
               DWObjectLargeViewer.LoadDibFromClipboard();
           }	
   
           function clearPreviousImages() {
               // Keep only the last scanned image
               var totalImages = DWObject.HowManyImagesInBuffer;
               if (totalImages > 1) {
                   // Remove all images except the last one
                   for (var i = totalImages - 2; i >= 0; i--) {
                       DWObject.RemoveImage(i);
                   }
                   // Update the current image index to 0 (since we now only have one image)
                   DWObject.CurrentImageIndexInBuffer = 0;
               }
           }
           
           function createImageBase64() {
               // Since we only keep one image, always use index 0
               var aryIndices = [0];
               
               // Convert to JPEG for display (better for web display than PDF)
               var displayType = Dynamsoft.EnumDWT_ImageType.IT_JPG;
               
               DWObject.ConvertToBase64(
                   aryIndices,
                   displayType,
                   function(result, indices, type) {
                       // Get the base64 data
                       var base64Data = result.getData(0, result.getLength());
                       
                       // Display the image in the img element
                       const imageElement = document.getElementById('uploadedImage');
                       const uploadedCanvas = document.getElementById('uploadedCanvas');
                       const uploadPlaceholder = document.getElementById('uploadPlaceholder');
                       imageElement.src = 'data:image/jpeg;base64,' + base64Data;
                       imageElement.style.display = 'block';
                       uploadedCanvas.style.display = 'none';
                       uploadPlaceholder.style.display = 'none';                     
                        
                       // Store the data for sending to server
                       scannedImageData = base64Data;
                       
                       // Show the send button
                       document.getElementById('sendBtn').style.display = 'inline-block';
                       
                       console.log('Image displayed successfully');
                       
                       // Also set the parent element value if needed
                       if (parent.document.getElementById('imageurlid')) {
                            parent.document.getElementById('imageurlid').value = base64Data;

                       }
                   },
                   function(errorCode, errorString) {
                       console.log('Error converting to base64: ' + errorString);
                       alert('Error processing image: ' + errorString);
                   }
               );
           }
           
           function sendToServer() {
               if (!scannedImageData) {
                   alert('No image data to send');
                   return;
               }
               
               // Example of sending to server via fetch API
               var formData = new FormData();
               
               // Convert base64 to blob
               var byteCharacters = atob(scannedImageData);
               var byteNumbers = new Array(byteCharacters.length);
               for (var i = 0; i < byteCharacters.length; i++) {
                   byteNumbers[i] = byteCharacters.charCodeAt(i);
               }
               var byteArray = new Uint8Array(byteNumbers);
               var blob = new Blob([byteArray], {type: 'image/jpeg'});
               
               formData.append('scanned_image', blob, 'scanned_document.jpg');
               
